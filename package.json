{
  "name": "universe-campus-os",
  "version": "1.0.0",
  "description": "UniVerse — An Intelligent, Sustainable, and Privacy-Aware Campus Ecosystem",
  "main": "server/src/index.ts",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/src/index.ts",
    "client:dev": "npm --prefix client run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "npm --prefix client run build",
    "start": "node dist/server/index.js",
    "seed": "tsx server/src/db/seed.ts",
    "seed:placements": "tsx server/src/db/import_placement_dataset.ts && tsx server/src/db/populate_dataset_activities.ts",
    "test": "vitest run"
  },
  "keywords": [
    "campus-os",
    "sustainability",
    "graph-algorithms",
    "ride-pooling",
    "wellbeing",
    "academic-hub"
  ],
  "author": "UniVerse Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
