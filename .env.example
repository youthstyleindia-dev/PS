# ==========================================
# UniVerse Campus OS: Environment Variables
# Zero paid API keys required. Self-contained.
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT & Authentication Security
JWT_SECRET=universe-super-secret-campus-os-jwt-key-2026

# Database Configuration
DATABASE_PATH=server/data/universe.db

# Sustainability Defaults
PUE_BASELINE=1.75
PUE_OPTIMIZED=1.20
DEFAULT_GRID_CARBON_INTENSITY=708.0

# Ride Pooling Constraints
DEFAULT_MAX_DETOUR_RATIO=0.35

# Differential Privacy Budget
DEFAULT_DP_EPSILON=0.8
MIN_COHORT_K_ANONYMITY=3
